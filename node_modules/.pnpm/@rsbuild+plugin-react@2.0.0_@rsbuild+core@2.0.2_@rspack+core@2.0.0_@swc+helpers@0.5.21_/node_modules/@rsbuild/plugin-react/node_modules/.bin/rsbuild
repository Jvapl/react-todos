else
  export NODE_PATH="/home/joaoaebi/Desktop/Jobtrek/Projets/react-todos/my-react-todo/node_modules/.pnpm/@rsbuild+core@2.0.2/node_modules/@rsbuild/core/node_modules:/home/joaoaebi/Desktop/Jobtrek/Projets/react-todos/my-react-todo/node_modules/.pnpm/@rsbuild+core@2.0.2/node_modules:/home/joaoaebi/Desktop/Jobtrek/Projets/react-todos/my-react-todo/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../core/bin/rsbuild.js" "$@"
else
